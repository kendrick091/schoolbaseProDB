<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Parent Payment Receipt</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <style>

        body {
            background: #f4f6f9;
            font-size: clamp(0.7rem, 1.5vw, 1.2rem);
        }

        .selection-card {
            max-width: 900px;
            margin: 30px auto;
            border: none;
            border-radius: 15px;
        }

        .display-info{
            background: #f8f9fa;
            padding: clamp(15px, 2vw, 25px);
            border-radius: 12px;
            margin-bottom: clamp(20px, 2vw, 30px);
            display: flex;
            justify-content: space-between;
        }

        .display-info .row .col-md-6{
            width: 100%;
        }

        .receipt-container {
            max-width: 900px;
            margin: 30px auto;
            background: white;
            padding: 35px;
            border-radius: 15px;
            display: none;
        }

        .receipt-header {
            text-align: center;
            border-bottom: 2px solid #ddd;
            padding-bottom: 20px;
            margin-bottom: 25px;
        }

        .receipt-title {
            font-weight: bold;
            font-size: 24px;
            margin-top: 10px;
        }

        .amount-card {
            background: #e8f7ee;
            padding: 25px;
            text-align: center;
            border-radius: 12px;
            margin: 25px 0;
        }

        .total-amount {
            font-size: 32px;
            font-weight: bold;
            color: #198754;
        }

        .payment-table th {
            background: #f8f9fa;
        }

        .action-buttons {
            max-width: 900px;
            margin: 20px auto;
            display: none;
            gap: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .receipt-stamp {
            max-width: clamp(100px, 20vw, 200px);
            max-height: clamp(100px, 20vw, 200px);
            object-fit: contain;
        }

        @media print {

            body {
                background: white;
            }

            .selection-card,
            .action-buttons {
                display: none !important;
            }

            .receipt-container {
                display: block !important;
                max-width: 100%;
                margin: 0;
                box-shadow: none;
                border: none;
            }

        }

    </style>

</head>


<body>


<div class="container">


    <!-- ========================================== -->
    <!-- RECEIPT SEARCH FORM -->
    <!-- ========================================== -->

    <div class="card selection-card shadow-sm">

        <div class="card-body p-4">

            <h3 class="mb-2">
                Parent Payment Receipt
            </h3>

            <p class="text-muted">
                Select payment details to view complete payment history.
            </p>


            <div
                id="messageBox"
                class="alert"
                style="display:none"
            ></div>


            <div class="row g-3">


                <!-- ACADEMIC SESSION -->

                <div class="col-md-6">

                    <label class="form-label">
                        Academic Session
                    </label>

                    <select
                        id="academicSessionId"
                        class="form-select"
                    >

                        <option value="">
                            Select Academic Session
                        </option>

                        <% academicSessions.forEach(session => { %>

                            <option
                                value="<%= session._id %>"
                            >

                                <%= session.academicSession
                                    || session.sessionName
                                    || session.name
                                    || '-'
                                %>

                            </option>

                        <% }) %>

                    </select>

                </div>



                <!-- PARENT -->

                <div class="col-md-6">

                    <label class="form-label">
                        Parent
                    </label>

                    <select
                        id="parentId"
                        class="form-select"
                    >

                        <option value="">
                            Select Parent
                        </option>

                        <% parents.forEach(parent => { %>

                            <option
                                value="<%= parent._id %>"
                            >

                                <%= parent.parentFullName
                                    || parent.parentName
                                    || parent.name
                                    || parent.phone
                                %>

                            </option>

                        <% }) %>

                    </select>

                </div>



                <!-- STUDENT -->

                <div class="col-md-6">

                    <label class="form-label">
                        Student
                    </label>

                    <select
                        id="studentId"
                        class="form-select"
                        disabled
                    >

                        <option value="">
                            Select Parent First
                        </option>

                    </select>

                </div>



                <!-- TERM -->

                <div class="col-md-6">

                    <label class="form-label">
                        Term
                    </label>

                    <select
                        id="term"
                        class="form-select"
                    >

                        <option value="">
                            Select Term
                        </option>

                        <option value="term1">
                            First Term
                        </option>

                        <option value="term2">
                            Second Term
                        </option>

                        <option value="term3">
                            Third Term
                        </option>

                    </select>

                </div>


            </div>

        </div>

    </div>



    <!-- ========================================== -->
    <!-- ACTION BUTTONS -->
    <!-- ========================================== -->

    <div
        class="action-buttons"
        id="actionButtons"
    >

        <button
            class="btn btn-primary"
            onclick="window.print()"
        >
            🖨 Print Receipt
        </button>


        <button
            class="btn btn-success"
            onclick="shareWhatsApp()"
        >
            📱 Send via WhatsApp
        </button>

    </div>



    <!-- ========================================== -->
    <!-- RECEIPT -->
    <!-- ========================================== -->

    <div
        class="receipt-container shadow-sm"
        id="receiptContainer"
    >


        <div class="receipt-header">

            <h5>
                <%=school.schoolname || school.name || 'SchoolBase' %>
            </h5>

            <h2 id="schoolname">
                SCHOOL PAYMENT RECEIPT
            </h2>

            <div class="receipt-title">
                PAYMENT HISTORY
            </div>

        </div>



        <!-- STUDENT INFORMATION -->

        <div class="display-info">
        <div class="row mb-4">

            <div class="col-md-6">

                <strong>
                    Parent:
                </strong>

                <span id="receiptParent"></span>

            </div>


            <div class="col-md-6">

                <strong>
                    Student:
                </strong>

                <span id="receiptStudent"></span>

            </div>


            <div class="col-md-6 mt-2">

                <strong>
                    Admission No:
                </strong>

                <span id="receiptAdmission"></span>

            </div>

            </div>

            <div class="row mb-4">

            <div class="col-md-6 mt-2">

                <strong>
                    Academic Session:
                </strong>

                <span id="receiptSession"></span>

            </div>


            <div class="col-md-6 mt-2">

                <strong>
                    Term:
                </strong>

                <span id="receiptTerm"></span>

            </div>

        </div>
        </div>



        <!-- PAYMENT HISTORY -->

        <h5 class="mb-3">
            Payment History
        </h5>


        <div class="table-responsive">

            <table
                class="table table-bordered payment-table"
            >

                <thead>

                    <tr>

                        <th>
                            S/N
                        </th>

                        <th>
                            Date Paid
                        </th>

                        <th>
                            Amount Paid
                        </th>

                        <th>
                            Payment Reference
                        </th>

                        <th>
                            Note
                        </th>

                    </tr>

                </thead>


                <tbody id="paymentHistoryBody">

                </tbody>

            </table>

        </div>



        <!-- TOTAL -->

        <div class="amount-card">

            <small>
                TOTAL AMOUNT PAID
            </small>

            <div
                class="total-amount"
                id="totalPaid"
            >
                ₦0
            </div>

        </div>

        <div class="text-center text-muted">

            <strong>
                Payment History Summary
            </strong>

            <br>

            This receipt contains all recorded installment
            payments made for this student.

            <br><br>

            <!---- Stamp and signature code below ----->
            <div class="stamp-signature">
                <% if (school.stampSignature) { %>

            <img
                src="/uploads/stamp/<%= school.stampSignature %>"
                alt="School Stamp and Signature"
                class="receipt-stamp"
            >

        <% } %>
            </div>
            <br>
            <i>Generated by SchoolBase.</i>

        </div>


    </div>


</div>



<script>


// =====================================================
// ELEMENTS
// =====================================================

const parentSelect =
    document.getElementById('parentId');

const studentSelect =
    document.getElementById('studentId');

const sessionSelect =
    document.getElementById('academicSessionId');

const termSelect =
    document.getElementById('term');

const receiptContainer =
    document.getElementById('receiptContainer');

const actionButtons =
    document.getElementById('actionButtons');

const messageBox =
    document.getElementById('messageBox');

let currentReceiptData = null;



// =====================================================
// LOAD STUDENTS WHEN PARENT CHANGES
// =====================================================

parentSelect.addEventListener(
    'change',
    async function () {

        const parentId = this.value;


        studentSelect.innerHTML =
            '<option value="">Loading students...</option>';

        studentSelect.disabled = true;

        hideReceipt();


        if (!parentId) {

            studentSelect.innerHTML =
                '<option value="">Select Parent First</option>';

            return;

        }


        try {

            const response =
                await fetch(
                    `/manualPaymentReceipts/parent/${parentId}/students`
                );


            const data =
                await response.json();


            if (!data.success) {

                throw new Error(
                    data.message
                );

            }


            studentSelect.innerHTML =
                '<option value="">Select Student</option>';


            data.students.forEach(
                student => {

                    const option =
                        document.createElement('option');

                    option.value =
                        student._id;

                    option.textContent =
                        `${student.studentFullName} (${student.admissionNumber || 'No Admission Number'})`;

                    studentSelect.appendChild(
                        option
                    );

                }
            );


            studentSelect.disabled = false;


        } catch (error) {

            console.error(error);

            showMessage(
                error.message ||
                'Unable to load students',
                'danger'
            );

        }

    }
);



// =====================================================
// AUTOMATICALLY LOAD RECEIPT
// =====================================================

[
    parentSelect,
    studentSelect,
    sessionSelect,
    termSelect
].forEach(element => {

    element.addEventListener(
        'change',
        loadReceipt
    );

});



async function loadReceipt() {


    const parentId =
        parentSelect.value;

    const studentId =
        studentSelect.value;

    const academicSessionId =
        sessionSelect.value;

    const term =
        termSelect.value;


    // Don't load until everything is selected

    if (
        !parentId ||
        !studentId ||
        !academicSessionId ||
        !term
    ) {

        hideReceipt();

        return;

    }


    try {

        receiptContainer.style.display =
            'block';


        document.getElementById(
            'paymentHistoryBody'
        ).innerHTML = `

            <tr>
                <td colspan="5" class="text-center">
                    Loading payment history...
                </td>
            </tr>

        `;


        const params =
            new URLSearchParams({

                parentId,
                studentId,
                academicSessionId,
                term

            });


        const response =
            await fetch(
                `/manualPaymentReceipts/history?${params}`
            );


        const data =
            await response.json();


        if (!data.success) {

            throw new Error(
                data.message ||
                'Unable to load receipt'
            );

        }


        currentReceiptData =
            data;


        displayReceipt(
            data
        );


    } catch (error) {

        console.error(error);


        hideReceipt();


        showMessage(
            error.message ||
            'Unable to load receipt',
            'danger'
        );

    }

}



// =====================================================
// DISPLAY RECEIPT
// =====================================================

function displayReceipt(data) {


    receiptContainer.style.display =
        'block';

    actionButtons.style.display =
        'flex';


    document.getElementById(
        'receiptParent'
    ).textContent =
        data.parentFullName || data.parent.name || '-';


    document.getElementById(
        'receiptStudent'
    ).textContent =
        data.student.name;


    document.getElementById(
        'receiptAdmission'
    ).textContent =
        data.student.admissionNumber;


    document.getElementById(
        'receiptSession'
    ).textContent =
        data.academicSession;


    document.getElementById(
        'receiptTerm'
    ).textContent =
        formatTerm(data.term);


    const paymentHistoryBody =
        document.getElementById(
            'paymentHistoryBody'
        );


    paymentHistoryBody.innerHTML =
        '';


    if (!data.payments.length) {

        paymentHistoryBody.innerHTML = `

            <tr>

                <td
                    colspan="5"
                    class="text-center text-muted py-4"
                >

                    No payment has been recorded yet.

                </td>

            </tr>

        `;

    } else {

        data.payments.forEach(
            (payment, index) => {

                const row =
                    document.createElement('tr');


                row.innerHTML = `

                    <td>
                        ${index + 1}
                    </td>

                    <td>
                        ${formatDate(
                            payment.createdAt
                        )}
                    </td>

                    <td>
                        ₦${Number(
                            payment.amount
                        ).toLocaleString()}
                    </td>

                    <td>
                        ${payment.reference || '-'}
                    </td>

                    <td>
                        ${payment.note || '-'}
                    </td>

                `;


                paymentHistoryBody.appendChild(
                    row
                );

            }
        );

    }


    document.getElementById(
        'totalPaid'
    ).textContent =

        `₦${Number(
            data.totalPaid
        ).toLocaleString()}`;

}



// =====================================================
// HIDE RECEIPT
// =====================================================

function hideReceipt() {

    receiptContainer.style.display =
        'none';

    actionButtons.style.display =
        'none';

    currentReceiptData =
        null;

}



// =====================================================
// FORMAT TERM
// =====================================================

function formatTerm(term) {

    const terms = {

        term1:
            'First Term',

        term2:
            'Second Term',

        term3:
            'Third Term'

    };


    return terms[term] || term;

}



// =====================================================
// FORMAT DATE
// =====================================================

function formatDate(date) {

    return new Date(
        date
    ).toLocaleDateString(
        'en-NG',
        {

            day: '2-digit',

            month: 'long',

            year: 'numeric'

        }
    );

}



// =====================================================
// WHATSAPP SHARE
// =====================================================

function shareWhatsApp() {

    if (!currentReceiptData) {

        return;

    }


    const data =
        currentReceiptData;


    let paymentHistory =
        '';


    data.payments.forEach(
        (payment, index) => {

            paymentHistory +=

`${index + 1}. ${formatDate(payment.createdAt)}
Amount: ₦${Number(payment.amount).toLocaleString()}
Ref: ${payment.reference || '-'}
\n`;

        }
    );


    const message =

`*SCHOOL FEE PAYMENT RECEIPT*

<!---- Parent: ${data.parent.name} ---->

Student: ${data.student.name}

Admission No: ${data.student.admissionNumber}

Academic Session: ${data.academicSession}

Term: ${formatTerm(data.term)}

*PAYMENT HISTORY*

${paymentHistory}

*TOTAL AMOUNT PAID: ₦${Number(data.totalPaid).toLocaleString()}*

This is a summary of all payments recorded by the school.

Generated by SchoolBase.`;


    const whatsappURL =

        `https://wa.me/?text=${encodeURIComponent(
            message
        )}`;


    window.open(
        whatsappURL,
        '_blank'
    );

}



// =====================================================
// SHOW MESSAGE
// =====================================================

function showMessage(message, type) {

    messageBox.style.display =
        'block';


    messageBox.className =
        `alert alert-${type}`;


    messageBox.textContent =
        message;

}

</script>


</body>

</html>