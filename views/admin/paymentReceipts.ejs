<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Payment Receipts - SchoolBase</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #f5f7fb;
            font-family: Arial, sans-serif;
        }

        .page-header {
            background: white;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border: none;
        }

        .receipt-card {
            background: white;
            border-radius: 12px;
            border: none;
            overflow: hidden;
        }

        .payment-method {
            font-size: 12px;
            padding: 5px 9px;
            border-radius: 20px;
            display: inline-block;
        }

        .paystack {
            background: #e7f8ef;
            color: #198754;
        }

        .manual {
            background: #fff3cd;
            color: #856404;
        }

        .payment-type {
            font-size: 12px;
            color: #6c757d;
        }

        .amount {
            font-weight: bold;
            color: #198754;
        }

        @media(max-width: 768px) {

            .table thead {
                display: none;
            }

            .table,
            .table tbody,
            .table tr,
            .table td {
                display: block;
                width: 100%;
            }

            .table tr {
                margin-bottom: 15px;
                border: 1px solid #eee;
                border-radius: 10px;
                padding: 10px;
            }

            .table td {
                border: none;
                padding: 6px;
            }

            .table td::before {
                content: attr(data-label);
                font-weight: bold;
                display: inline-block;
                width: 120px;
            }

        }

    </style>

</head>


<body>


<div class="container-fluid py-4">


    <!-- ========================================= -->
    <!-- HEADER -->
    <!-- ========================================= -->

    <div class="page-header">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>

                <h3 class="mb-1">
                    Payment Receipts
                </h3>

                <p class="text-muted mb-0">
                    <!-- View and print student payment receipts -->
                     View and Print SchoolBase Payment Receipts
                </p>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- STATISTICS -->
    <!-- ========================================= -->

    <!---<div class="row g-3 mb-4">

            <div class="col-md-4">

            <div class="stat-card shadow-sm">

                <small class="text-muted">
                    Total Payments
                </small>

                <h3 class="mt-2 mb-0">
                    <%= payments.length %>
                </h3>

            </div>

        </div> -->


        <!-- <div class="col-md-4">

            <div class="stat-card shadow-sm">

                <small class="text-muted">
                    Total Amount
                </small>

                <h3 class="mt-2 mb-0 text-success">

                    ₦<%= Number(totalAmount).toLocaleString() %>

                </h3>

            </div>

        </div> -->


        <!-- <div class="col-md-4">

            <div class="stat-card shadow-sm">

                <small class="text-muted">
                    Payment Records
                </small>

                <h3 class="mt-2 mb-0">

                    <%= payments.length %>

                </h3>

            </div>

        </div>

    </div>
 -->


    <!-- ========================================= -->
    <!-- FILTERS -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-3">


                <div class="col-md-5">

                    <label class="form-label">
                        Search student
                    </label>

                    <input
                        type="text"
                        id="searchInput"
                        class="form-control"
                        placeholder="Student name or admission number..."
                    >

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Term
                    </label>

                    <select id="termFilter" class="form-select">

                        <option value="">
                            All Terms
                        </option>

                        <option value="term1">
                            First Term
                        </option>

                        <option value="term2">
                            Second Term
                        </option>

                        <option value="term3">
                            Third Term
                        </option>

                    </select>

                </div>


                <div class="col-md-3">

                    <label class="form-label">
                        Payment Method
                    </label>

                    <select id="methodFilter" class="form-select">

                        <option value="">
                            All Methods
                        </option>

                        <option value="paystack">
                            Paystack
                        </option>

                        <option value="manual">
                            Manual
                        </option>

                    </select>

                </div>


                <div class="col-md-1 d-flex align-items-end">

                    <button
                        class="btn btn-secondary w-100"
                        onclick="clearFilters()"
                    >
                        ×
                    </button>

                </div>

            </div>

        </div>

    </div>



    <!-- ========================================= -->
    <!-- PAYMENTS TABLE -->
    <!-- ========================================= -->

    <div class="card receipt-card shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            Student
                        </th>

                        <th>
                            Admission No.
                        </th>

                        <th>
                            Amount
                        </th>

                        <th>
                            Term
                        </th>

                        <th>
                            Method
                        </th>

                        <th>
                            Academic Year
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Receipt
                        </th>

                    </tr>

                </thead>


                <tbody id="paymentsTable">

                <% if (payments.length === 0) { %>

                    <tr>

                        <td
                            colspan="7"
                            class="text-center py-5"
                        >

                            <h5>
                                No payment records found
                            </h5>

                            <p class="text-muted mb-0">
                                Payment receipts will appear here.
                            </p>

                        </td>

                    </tr>

                <% } %>


                <% payments.forEach(payment => { %>


                    <tr
                        class="payment-row"
                        data-name="<%= (payment.student?.studentFullName || '').toLowerCase() %>"
                        data-admission="<%= (payment.student?.admissionNumber || '').toLowerCase() %>"
                        data-term="<%= payment.term || '' %>"
                        data-method="<%= (payment.paymentMethod || '').toLowerCase() %>"
                    >


                        <td data-label="Student">

                            <strong>

                                <%= payment.student?.studentFullName || 'Multiple Students' %>

                            </strong>

                        </td>


                        <td data-label="Admission No.">

                            <%= payment.student?.admissionNumber || '-' %>

                        </td>


                        <td data-label="Amount">

                            <span class="amount">

                                ₦<%= Number(payment.amount || 0).toLocaleString() %>

                            </span>

                        </td>


                        <td data-label="Term">

                            <% if (payment.term === 'term1') { %>

                                First Term

                            <% } else if (payment.term === 'term2') { %>

                                Second Term

                            <% } else if (payment.term === 'term3') { %>

                                Third Term

                            <% } else { %>

                                <%= payment.term || '-' %>

                            <% } %>

                        </td>


                        <td data-label="Method">

                            <% if ((payment.paymentMethod || '').toLowerCase() === 'paystack') { %>

                                <span class="payment-method paystack">
                                    Paystack
                                </span>

                            <% } else { %>

                                <span class="payment-method manual">
                                    <%= payment.paymentMethod || 'Manual' %>
                                </span>

                            <% } %>

                            <br>

                            <span class="payment-type">

                                <%= payment.paymentType || '' %>

                            </span>

                        </td>

                        <td>
                            <%= payment.session?.sessionName
                    || payment.session?.academicSession
                    || payment.session?.name
                    || '-'
                %>
                        </td>


                        <td data-label="Date">

                            <%= payment.createdAt
                                ? new Date(payment.createdAt).toLocaleDateString('en-NG', {
                                    day: '2-digit',
                                    month: 'short',
                                    year: 'numeric'
                                })
                                : '-'
                            %>

                        </td>


                        <td data-label="Receipt">

                            <a
                                href="/paymentReceipts/<%= payment._id %>"
                                class="btn btn-sm btn-primary"
                            >

                                View

                            </a>

                        </td>


                    </tr>


                <% }) %>

                </tbody>

            </table>

        </div>

    </div>


</div>



<script>

const searchInput = document.getElementById('searchInput');
const termFilter = document.getElementById('termFilter');
const methodFilter = document.getElementById('methodFilter');


function filterPayments() {

    const search = searchInput.value
        .toLowerCase()
        .trim();

    const term = termFilter.value;

    const method = methodFilter.value
        .toLowerCase();


    const rows = document.querySelectorAll('.payment-row');


    rows.forEach(row => {

        const name =
            row.dataset.name || '';

        const admission =
            row.dataset.admission || '';

        const rowTerm =
            row.dataset.term || '';

        const rowMethod =
            row.dataset.method || '';


        const matchesSearch =
            name.includes(search) ||
            admission.includes(search);


        const matchesTerm =
            !term ||
            rowTerm === term;


        const matchesMethod =
            !method ||
            rowMethod === method;


        if (
            matchesSearch &&
            matchesTerm &&
            matchesMethod
        ) {

            row.style.display = '';

        } else {

            row.style.display = 'none';

        }

    });

}


searchInput.addEventListener(
    'input',
    filterPayments
);

termFilter.addEventListener(
    'change',
    filterPayments
);

methodFilter.addEventListener(
    'change',
    filterPayments
);


function clearFilters() {

    searchInput.value = '';

    termFilter.value = '';

    methodFilter.value = '';

    filterPayments();

}

</script>


</body>

</html>