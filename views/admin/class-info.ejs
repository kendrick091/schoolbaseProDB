<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheet/dashboard.css">
    <link rel="stylesheet" href="/stylesheet/class-info.css">
    <link rel="stylesheet" href="/stylesheet/menuToggle.css">
    <link rel="stylesheet" href="/stylesheet/table.css">
</head>
<body>
    <div class="dashboard">

  <!-- Sidebar (UNCHANGED) -->
  <aside class="sidebar">
    <h2 class="logo">SchoolBase</h2>

    <nav>
      <a href="/admin">Dashboard</a>
      <a href="/admin/student">Students</a>
      <a href="/teachers">Teachers</a>
      <a href="/sessions">Academic Sessions</a>
      <a href="/classes" class="active">Classes</a>
      <a href="/subjects">Subjects</a>
      <a href="/fees">Fee Management</a>
      <a href="/adminResult">Results</a>
      <a href="/settings">Settings</a>
    </nav>

    <a href="/logout" class="logout">Logout</a>
  </aside>

  <!-- Main Content -->
  <main class="content">
    <button class="menu-btn" onclick="toggleMenu()">☰</button>

    <header class="topbar">
      <h1>Class Information</h1>
      <span class="date" id="todayDate"></span>
    </header>

    <!-- Class Summary -->
    <section class="info-card">
      <h2><%= classInfo.className %></h2>

      <div class="info-grid">
        <div>
          <strong>Total Students:</strong>
          <span><%= students.length %></span>
        </div>

        <div>
          <strong>Class Teacher:</strong>
          <span>
            <%= classTeacher ? classTeacher.teacherName : 'Not Assigned' %>
          </span>
        </div>
      </div>
    </section>

    <!-- Students Table -->
    <section class="table-section">
      <div class="table-header">
        <h2>Students in this Class</h2>
      </div>

      <div class="table-wrapper">
        <table class="styled-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Admission.No</th>
              <th>Student Name</th>
              <th>Gender</th>
              <th>Action</th>
            </tr>
          </thead>

          <tbody>
            <% if (students.length === 0) { %>
              <tr>
                <td colspan="3" style="text-align:center;">
                  No students assigned to this class
                </td>
              </tr>
            <% } %>

            <% students.forEach((student, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= student.admissionNumber %></td>
                <td><%= student.studentFullName %></td>
                <td><%= student.gender %></td>
                <td>
                  <!--- code to promote student -->
        <label for="newClassId">Promote to Class:</label>

<select style="margin: 0 0 5px 0;"
  class="promotion-select"
  onchange="promoteStudent('<%= student._id %>', this, '<%= student.studentClass %>')"
>
  <option value="">
    Select New Class
  </option>

  <% classList.forEach(cls => { %>

    <option value="<%= cls._id %>">
      <%= cls.className %>
    </option>

  <% }) %>
</select>
<br>

                  <a href="/classinfo/delete/<%= student._id %>">
                    <button class="btn delete" style="padding: 8px;">
                      Delete
                    </button>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <div class="promotion-div" style="
  padding: 12px;
  background: #007780;
  color: white;
  display: inline-block;
  border-radius: 8px;
  margin-bottom: 15px;
">

  <h4 style="margin-top: 0;">
    Promote All Students in this Class
  </h4>

  <select
    id="bulkClassSelect"
    style="padding: 8px; width: 100%; margin-bottom: 8px;"
  >
    <option value="">
      Select New Class
    </option>

    <% classList.forEach(cls => { %>
      <option value="<%= cls._id %>">
        <%= cls.className %>
      </option>
    <% }) %>
  </select>

  <button
    type="button"
    style="padding: 10px; cursor: pointer;"
    onclick="promoteAllStudents('<%= classInfo._id %>')"
  >
    Promote All
  </button>

</div>

    <!-- Teachers Table -->
    <section class="table-section">
      <div class="table-header">
        <h2>Teachers</h2>
      </div>

      <div class="table-wrapper">
        <table class="styled-table">
          <thead>
            <tr>
              <th>#</th>
              <th>Teacher Name</th>
              <th>Role</th>
            </tr>
          </thead>

          <tbody>
            <% if (teachers.length === 0) { %>
              <tr>
                <td colspan="3" style="text-align:center;">
                  No teachers assigned to this class
                </td>
              </tr>
            <% } %>

            <% teachers.forEach((teacher, index) => { %>
              <tr>
                <td><%= index + 1 %></td>
                <td><%= teacher.teacherName %></td>
                <td><%= teacher.teacherRole %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

  </main>
</div>
<script src="/scriptFolder/menuToggle.js"></script>
<script src="/scriptFolder/showDate.js"></script>


// student promotion function
<script>
function promoteStudent(studentId, selectElement, currentClassId) {

  const newClassId = selectElement.value;

  // Nothing selected
  if (!newClassId) {
    return;
  }

  // Prevent selecting same class
  if (newClassId === currentClassId) {
    alert("The student is already in this class.");

    selectElement.value = "";

    return;
  }

  const selectedClassName =
    selectElement.options[selectElement.selectedIndex].text;

  const confirmed = confirm(
    `Are you sure you want to promote this student to ${selectedClassName}?`
  );

  if (!confirmed) {
    selectElement.value = "";
    return;
  }

  // Disable dropdown while request is processing
  selectElement.disabled = true;

  fetch(`/classinfo/promote-student/${studentId}`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      newClassId: newClassId
    })
  })
  .then(async res => {

    const data = await res.json();

    if (!res.ok) {
      throw new Error(data.message || "Unable to promote student");
    }

    return data;
  })
  .then(data => {

    alert(data.message);

    // Reload class page because student has left this class
    location.reload();

  })
  .catch(err => {

    console.error("Promotion error:", err);

    alert(err.message || "Error promoting student");

    selectElement.value = "";
    selectElement.disabled = false;

  });
}
</script>

<script>

function promoteAllStudents(currentClassId) {

  const selectElement = document.getElementById("bulkClassSelect");
  const newClassId = selectElement.value;

  // Make sure a class was selected
  if (!newClassId) {
    alert("Please select the class you want to promote the students to.");
    return;
  }

  // Prevent promoting to the same class
  if (newClassId === currentClassId) {
    alert("The students are already in this class.");
    return;
  }

  const selectedClassName =
    selectElement.options[selectElement.selectedIndex].text;

  const confirmed = confirm(
    `Are you sure you want to promote ALL students in this class to ${selectedClassName}?`
  );

  if (!confirmed) {
    return;
  }

  // Disable button while processing
  const button = document.querySelector(
    '.promotion-div button'
  );

  button.disabled = true;
  button.textContent = "Promoting...";

  fetch(`/classinfo/promote-all`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    },
    body: JSON.stringify({
      currentClassId,
      newClassId
    })
  })

  .then(async res => {

    const data = await res.json();

    if (!res.ok) {
      throw new Error(
        data.message || "Unable to promote students."
      );
    }

    return data;
  })

  .then(data => {

    alert(data.message);

    location.reload();

  })

  .catch(err => {

    console.error("BULK PROMOTION ERROR:", err);

    alert(err.message || "Error promoting students.");

    button.disabled = false;
    button.textContent = "Promote All";

  });

}

</script>

</body>
</html>