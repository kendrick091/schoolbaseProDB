<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fees</title>
    <link rel="stylesheet" href="/stylesheet/fees.css">
    <link rel="stylesheet" href="/stylesheet/dashboard.css">
    <link rel="stylesheet" href="/stylesheet/menuToggle.css">
    <link rel="stylesheet" href="/stylesheet/table.css">
    <link rel="stylesheet" href="/stylesheet/form.css">
    <script src="https://js.paystack.co/v1/inline.js"></script>

</head>
<body>
    <div class="container_content">
    <% if (schoolId){%>
       <div class="dashboard">

  <!-- Sidebar (UNCHANGED) -->
  <aside class="sidebar">
    <h2 class="logo">SchoolBase</h2>

    <nav>
      <a href="/admin">Dashboard</a>
      <a href="/admin/student">Students</a>
      <a href="/teachers">Teachers</a>
      <a href="/sessions">Academic Sessions</a>
      <a href="/classes">Classes</a>
      <a href="/subjects">Subjects</a>
      <a href="/fees" class="active">Fee Management</a>
      <a href="/adminResult">Results</a>
      <a href="/settings">Settings</a>
    </nav>

    <a href="/logout" class="logout">Logout</a>
  </aside>

  <!-- Main -->
  <main class="content">
    <button class="menu-btn" onclick="toggleMenu()">☰</button>

    <header class="topbar">
      <h1>Fee Management</h1>
      <span class="date" id="todayDate"></span>
    </header>

    <div style="
  margin: 20px 0;
  padding: 20px;
  background: #0f5132;
  color: white;
  border-radius: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
">
  <div>
    <h2>School Fees Summary</h2>
    <p>Total Students: <strong><%= totalStudents %></strong></p>
    <p>Fee per Student: ₦<strong><%= feePerStudent %></strong></p>
  </div>

  <% if (students.length > 0 ){%>
    <div style="margin-top:15px;">

    <label><strong>Select Term</strong></label>

    <select id="paymentTerm" style="
        padding:10px;
        border-radius:6px;
        margin-left:10px;
    ">
        <option value="">Choose Term</option>
        <option value="term1">First Term</option>
        <option value="term2">Second Term</option>
        <option value="term3">Third Term</option>
    </select>

</div>

    <button
    onclick="paySchoolFees()"
    style="
      background: #198754;
      color: white;
      font-size: 22px;
      padding: 15px 25px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    "
  >
    Pay ₦<%= totalSchoolFee.toLocaleString() %>
  </button>
  <%}else{%>
    <h2 style="color: rgb(75, 75, 211);">Paid Already</h2>
  <%}%>
  
</div>

<!---- List student that has not pay schoolfees---->
<div class="table-container">
  <div class="table-header">
    <h2>Students</h2>

    <input
      type="text"
      id="searchInput"
      placeholder="Search student..."
      onkeyup="searchTable()"
    />

    </div>
  <table id="studentTable">
    <thead>
      <tr>
        <th>Student ID</th>
        <th>Full Name</th>
        <th>Class</th>
        <th>Payment Status</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% students.forEach(student => { %>
        <tr>
          <td><%= student.admissionNumber %></td>
          <td><%= student.studentFullName %></td>
          <td><%= student.className %></td>
          <td><%= student.payment ? 'Paid' : 'Not Paid' %></td>
          <td>
            <a href="/adminPayForEachStudent/<%= student._id %>">
              <button class="pay-button" style="
                background: #198754;
                color: white;
                border: none;
                padding: 10px 20px;
                border-radius: 5px;
                cursor: pointer;
              ">
                Pay ₦350
              </button>
            </a>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  </div>

    <%}else{%>
      <p>unauthorized</p>
    <%}%>
</div>
<!-- <script>
  window.PAYSTACK_PUBLIC_KEY = "<%= paystackKey %>";
</script> -->
<script src="/scriptFolder/searchTable.js"></script>
<script src="/scriptFolder/menuToggle.js"></script>

<script>
  window.PAYSTACK_KEY = "<%= paystackKey %>";
  window.TOTAL_SCHOOL_FEE = "<%= totalSchoolFee %>";
  window.SCHOOL_EMAIL = "<%= schoolEmail %>";
</script>

<script src="/scriptFolder/paySchool.js"></script>

</body>
</html>