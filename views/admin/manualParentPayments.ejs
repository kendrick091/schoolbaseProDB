<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Record Parent Payment</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>

        body {
            background: #f5f7fb;
        }

        .payment-card {
            max-width: 750px;
            margin: 40px auto;
            border: none;
            border-radius: 15px;
        }

        .card-header-custom {
            background: #0d6efd;
            color: white;
            padding: 25px;
            border-radius: 15px 15px 0 0;
        }

        .form-label {
            font-weight: 600;
        }

    </style>

</head>


<body>


<div class="container">


    <div class="card payment-card shadow-sm">


        <!-- HEADER -->

        <div class="card-header-custom">

            <h3 class="mb-1">
                Record Parent Payment
            </h3>

            <p class="mb-0">

                Record cash or direct payments made by parents.

            </p>

        </div>



        <div class="card-body p-4">


            <!-- ALERT -->

            <div
                id="messageBox"
                style="display:none"
                class="alert"
            >
            </div>



            <form id="paymentForm">


                <!-- ================================= -->
                <!-- ACADEMIC SESSION -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label class="form-label">

                        Academic Session *

                    </label>


                    <select
                        id="academicSessionId"
                        class="form-select"
                        required
                    >

                        <option value="">

                            Select Academic Session

                        </option>


                        <% academicSessions.forEach(session => { %>

                            <option value="<%= session._id %>">

                                <%= session.academicSession
                                    || session.sessionName
                                    || session.name
                                    || 'Academic Session'
                                %>

                            </option>

                        <% }) %>

                    </select>

                </div>



                <!-- ================================= -->
                <!-- PARENT -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label class="form-label">

                        Parent *

                    </label>


                    <select
                        id="parentId"
                        class="form-select"
                        required
                    >

                        <option value="">

                            Select Parent

                        </option>


                        <% parents.forEach(parent => { %>

                            <option value="<%= parent._id %>">

                                <%= parent.parentFullName
                                    || parent.parentName
                                    || parent.name
                                    || parent.phone
                                %>

                            </option>

                        <% }) %>

                    </select>

                </div>



                <!-- ================================= -->
                <!-- STUDENT -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label class="form-label">

                        Student *

                    </label>


                    <select
                        id="studentId"
                        class="form-select"
                        required
                        disabled
                    >

                        <option value="">

                            First select a parent

                        </option>

                    </select>

                </div>



                <!-- ================================= -->
                <!-- TERM -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label class="form-label">

                        Term *

                    </label>


                    <select
                        id="term"
                        class="form-select"
                        required
                    >

                        <option value="">

                            Select Term

                        </option>

                        <option value="term1">

                            First Term

                        </option>

                        <option value="term2">

                            Second Term

                        </option>

                        <option value="term3">

                            Third Term

                        </option>

                    </select>

                </div>



                <!-- ================================= -->
                <!-- AMOUNT -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label class="form-label">

                        Amount Paid (₦) *

                    </label>


                    <input
                        type="number"
                        id="amount"
                        class="form-control"
                        placeholder="Enter amount paid"
                        min="1"
                        required
                    >

                    <small class="text-muted">

                        You can record installment payments separately.

                    </small>

                </div>



                <!-- ================================= -->
                <!-- NOTE -->
                <!-- ================================= -->

                <div class="mb-4">

                    <label class="form-label">

                        Note (Optional)

                    </label>


                    <textarea
                        id="note"
                        class="form-control"
                        rows="3"
                        placeholder="Example: First installment"
                    ></textarea>

                </div>



                <!-- ================================= -->
                <!-- SUBMIT -->
                <!-- ================================= -->

                <button
                    type="submit"
                    class="btn btn-primary w-100 py-2"
                >

                    Record Payment

                </button>


            </form>


        </div>


    </div>


</div>



<script>


// ================================================
// ELEMENTS
// ================================================

const parentSelect =
    document.getElementById('parentId');

const studentSelect =
    document.getElementById('studentId');

const paymentForm =
    document.getElementById('paymentForm');

const messageBox =
    document.getElementById('messageBox');


// ================================================
// LOAD STUDENTS WHEN PARENT IS SELECTED
// ================================================

parentSelect.addEventListener(
    'change',
    async function () {

        const parentId = this.value;


        // Reset student select

        studentSelect.innerHTML =
            '<option value="">Loading students...</option>';

        studentSelect.disabled = true;


        if (!parentId) {

            studentSelect.innerHTML =
                '<option value="">First select a parent</option>';

            return;

        }


        try {

            const response =
                await fetch(
                    `/manualParentPayments/parent/${parentId}/students`
                );


            const data =
                await response.json();


            if (!data.success) {

                throw new Error(
                    data.message
                );

            }


            studentSelect.innerHTML =
                '<option value="">Select Student</option>';


            data.students.forEach(
                student => {

                    const option =
                        document.createElement('option');


                    option.value =
                        student._id;


                    option.textContent =
                        `${student.studentFullName} (${student.admissionNumber || 'No Admission No.'})`;


                    studentSelect.appendChild(
                        option
                    );

                }
            );


            studentSelect.disabled = false;


        } catch (error) {

            console.error(error);


            studentSelect.innerHTML =
                '<option value="">Unable to load students</option>';


            showMessage(
                'Unable to load students',
                'danger'
            );

        }

    }
);


// ================================================
// SAVE PAYMENT
// ================================================

paymentForm.addEventListener(
    'submit',
    async function (event) {

        event.preventDefault();


        const button =
            paymentForm.querySelector(
                'button[type="submit"]'
            );


        button.disabled = true;

        button.textContent =
            'Saving Payment...';


        const paymentData = {

            academicSessionId:
                document.getElementById(
                    'academicSessionId'
                ).value,

            parentId:
                parentSelect.value,

            studentId:
                studentSelect.value,

            term:
                document.getElementById(
                    'term'
                ).value,

            amount:
                document.getElementById(
                    'amount'
                ).value,

            note:
                document.getElementById(
                    'note'
                ).value

        };


        try {

            const response =
                await fetch(
                    '/manualParentPayments/save',
                    {

                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(
                                paymentData
                            )

                    }
                );


            const data =
                await response.json();


            if (!response.ok) {

                throw new Error(
                    data.message ||
                    'Unable to save payment'
                );

            }


            showMessage(
                'Payment recorded successfully!',
                'success'
            );


            // Reset payment fields

            document.getElementById('amount').value = '';


            document.getElementById('note').value = '';


        } catch (error) {

            console.error(error);


            showMessage(
                error.message,
                'danger'
            );

        } finally {

            button.disabled = false;

            button.textContent =
                'Record Payment';

        }

    }
);


// ================================================
// SHOW MESSAGE
// ================================================

function showMessage(message, type) {

    messageBox.style.display =
        'block';


    messageBox.className =
        `alert alert-${type}`;


    messageBox.textContent =
        message;


    window.scrollTo({
        top: 0,
        behavior: 'smooth'
    });

}


</script>


</body>

</html>