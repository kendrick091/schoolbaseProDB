<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>School Fees</title>

    <link rel="stylesheet" href="/stylesheet/dashboard.css">
    <link rel="stylesheet" href="/parentStylesheet/dashboard.css">
    <link rel="stylesheet" href="/parentStylesheet/payFee.css">

</head>

<body>

<div class="fees-container">

    <div class="fees-card">

        <h2>School Fees</h2>

        <!-- ==========================================
             STUDENT INFORMATION
        =========================================== -->

        <div class="student-info">

            <h3>
                <%= student.studentFullName %>
            </h3>

            <p>
                Admission No:
                <strong>
                    <%= student.admissionNumber %>
                </strong>
            </p>

            <p>
                Class:
                <strong>
                    <%= studentClass.className %>
                </strong>
            </p>

        </div>


        <hr>


        <!-- ==========================================
             SELECT SESSION AND TERM
        =========================================== -->

        <h3>Fee Details</h3>

        <div class="form-group">

            <label for="sessionId">
                Academic Session
            </label>

            <select id="sessionId" required>

                <% allAcademicSessions.forEach((option) => { %>

                    <option
                        value="<%= option._id %>"
                        <%= session && option._id.toString() === session._id.toString() ? 'selected' : '' %>
                    >
                        <%= option.academicSession %>
                    </option>

                <% }); %>

            </select>

        </div>


        <div class="form-group">

            <label for="term">
                Term
            </label>

            <select id="term" required>

                <option value="term1">1st Term</option>
                <option value="term2">2nd Term</option>
                <option value="term3">3rd Term</option>

            </select>

        </div>


        <!-- ==========================================
             CURRENT FEE
        =========================================== -->

        <div class="fee-box">

            <p>
                School Fee for Selected Term
            </p>

            <h3 id="schoolFee">
                ₦0
            </h3>

        </div>


        <!-- ==========================================
             PAYMENT SUMMARY
        =========================================== -->

        <div class="fee-summary">

            <div class="summary-box">

                <h4>
                    Total Fee
                </h4>

                <strong id="totalFee">
                    ₦0
                </strong>

            </div>


            <div class="summary-box">

                <h4>
                    Amount Paid
                </h4>

                <strong id="amountPaid">
                    ₦0
                </strong>

            </div>


            <div class="summary-box">

                <h4>
                    Remaining
                </h4>

                <strong id="remainingAmount">
                    ₦0
                </strong>

            </div>

        </div>


        <!-- ==========================================
             PAYMENT FORM
        =========================================== -->

        <div id="paymentSection">

            <h3>
                Make Payment
            </h3>

            <form
                action="/parentDashBoard/pay-fees/<%= student._id %>"
                method="POST"
                id="paymentForm"
            >

                <input
                    type="hidden"
                    name="sessionId"
                    id="formSessionId"
                >

                <input
                    type="hidden"
                    name="term"
                    id="formTerm"
                >


                <div class="form-group">

                    <label for="amount">
                        Amount to Pay
                    </label>

                    <input
                        type="number"
                        id="amount"
                        name="amount"
                        min="1"
                        step="1"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="pay-button"
                    id="payButton"
                >
                    Pay Now
                </button>

            </form>

        </div>


        <!-- ==========================================
             COMPLETED MESSAGE
        =========================================== -->

        <div
            id="completedMessage"
            class="completed hidden"
        >
            This term's school fees have been fully paid.
        </div>


        <!-- ==========================================
             PAYMENT HISTORY
        =========================================== -->

        <div class="payment-history">

            <h3>
                Payment History
            </h3>

            <table>

                <thead>

                    <tr>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Method</th>
                    </tr>

                </thead>

                <tbody id="paymentHistory">

                    <% if (paymentHistory && paymentHistory.length > 0) { %>

                        <% paymentHistory.forEach(payment => { %>

                            <tr>

                                <td>
                                    <%= new Date(payment.createdAt).toLocaleDateString() %>
                                </td>

                                <td>
                                    ₦<%= Number(payment.amount).toLocaleString() %>
                                </td>

                                <td>
                                    <%= payment.paymentMethod || 'manual' %>
                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td colspan="3">
                                No payment has been made for this term.
                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

</div>


<script>

    // ==========================================
    // FEES FROM SERVER
    // ==========================================

    const fees = <%- JSON.stringify(fees) %>;

    const paymentSummary =
        <%- JSON.stringify(paymentSummary || {}) %>;

</script>
<script src="/parent/payFee.js"></script>

</body>

</html>
